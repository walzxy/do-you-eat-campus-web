# 后端配置
# 服务端口，开发环境默认 3001
PORT=3001

# 运行环境：development | production
NODE_ENV=development

# 允许访问后端的来源地址（CORS）
# 开发环境默认 http://localhost:5173
# 生产环境改为 GitHub Pages 域名
CORS_ORIGIN=http://localhost:5173

# 数据文件存储目录（相对于 backend 目录）
DATA_DIR=../data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 反馈存储后端：file（本地 JSON 文件）| cloudbase（云开发数据库）
# 本地开发保持默认 file，云函数环境自动设为 cloudbase
# FEEDBACK_STORAGE=file
# 账号、饭录、社区内容存储后端：file（本地 JSON 文件）| cloudbase（云开发数据库）
# 本地开发保持默认 file，云函数环境自动设为 cloudbase
# SOCIAL_STORAGE=file
# 主数据存储后端：file（本地 JSON 文件）| cloudbase（云开发数据库）
# MENU_STORAGE=file

# 管理口令（仅部署时在云函数环境变量中设置，禁止写入前端代码或 Git）
# ADMIN_PASSWORD=
# 管理 Token 签名密钥（建议单独设置；修改后会使旧 Token 失效）
# ADMIN_TOKEN_SECRET=
# --- 前端配置 ---
# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:3001
